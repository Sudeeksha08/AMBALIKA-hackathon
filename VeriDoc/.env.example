# Local Node.js API port. Default Vite proxy expects 4100.
PORT=4100
# Local OCR uses the installed English model; no network call is needed at runtime.
OCR_ENABLED=true
# SQLite reports retain extracted text, names, metadata, and notes (1-30 days).
RETENTION_DAYS=7
# Optional public API base; default /api is recommended. Never put secrets here.
VITE_API_BASE_URL=/api
